; Little Digger — a cheerful construction site for little hands.
config_version=5

[application]
config/name="Little Builders | Construction Games"
config/description="Toy construction games for little hands. Licensed under GNU AGPL v3 or later (AGPL-3.0-or-later); see LICENSE and README.md for license notices."
run/main_scene="res://scenes/opening.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.66, 0.75, 0.78, 1)
lights_and_shadows/directional_shadow/size=2048

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=9.8

[input]

up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194320), Object(InputEventKey,"physical_keycode":87)]
}
down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194322), Object(InputEventKey,"physical_keycode":83)]
}
left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194319), Object(InputEventKey,"physical_keycode":65)]
}
right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194321), Object(InputEventKey,"physical_keycode":68)]
}
scoop={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
reset={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
mute={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}
menu_excavator={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
menu_bulldozer={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
menu_loader={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}

[layer_names]
3d_physics/layer_1="Yard"
3d_physics/layer_2="Vehicle"
3d_physics/layer_3="Boulders"
3d_physics/layer_4="Ground with holes"

[editor]
import/blender/enabled=false

